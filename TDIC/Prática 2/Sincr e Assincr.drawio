        <mxCell id="x2Nzxi6drnvT8Xg-KntE-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Contextualização&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="217" x="305" y="490" as="geometry" />
        </mxCell>
        <mxCell id="x2Nzxi6drnvT8Xg-KntE-22" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;Síncrona&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Um grupo de colegas fazem uma chamada de áudio ou de vídeo para falarem sobre a temperatura do ambiente em tempo real, que por ventura está calor nesses últimos tempos.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="370" x="20" y="580" as="geometry" />
        </mxCell>
        <mxCell id="x2Nzxi6drnvT8Xg-KntE-23" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;Assíncrona&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Um grupo de colegas planejam resolver o problema da temperatura do ambiente e ir atrás de uma resposta para resolver o problema mencionado.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="370" x="440" y="580" as="geometry" />
        </mxCell>
