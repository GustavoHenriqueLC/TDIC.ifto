        <mxCell id="x2Nzxi6drnvT8Xg-KntE-6" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;Síncrona&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Método de pronunciar atividades em tempo real e exibi resposta na mesma hora por meio de comunicação em chamadas de áudio ou de vídeo.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="370" x="20" y="250" as="geometry" />
