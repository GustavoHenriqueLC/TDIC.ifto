        <mxCell id="x2Nzxi6drnvT8Xg-KntE-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b style=&quot;line-height: 130%;&quot;&gt;&lt;font style=&quot;font-size: 31px;&quot; face=&quot;Georgia&quot;&gt;Síncona e Assícrona&lt;/font&gt;&lt;/b&gt;" vertex="1">
