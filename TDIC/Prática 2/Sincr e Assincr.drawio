        <mxCell id="x2Nzxi6drnvT8Xg-KntE-9" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 29px;&quot;&gt;Assíncrona&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;Método de pronunciar atividades sem ser em tempo real, vai mais em passar atividade e dá um prazo de resposta.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="370" x="440" y="250" as="geometry" />
